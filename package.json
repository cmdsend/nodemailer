{
  "name": "@cmdsend/nodemailer",
  "version": "0.1.0",
  "description": "Nodemailer transport for cmdsend.com — transactional email API on Amazon SES",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "nodemailer",
    "nodemailer-transport",
    "transport",
    "email",
    "smtp",
    "ses",
    "aws-ses",
    "transactional",
    "transactional-email",
    "cmdsend"
  ],
  "peerDependencies": {
    "nodemailer": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "author": "Sandeep Singh",
  "license": "MIT",
  "homepage": "https://cmdsend.com",
  "bugs": {
    "url": "https://github.com/cmdsend/nodemailer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdsend/nodemailer.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
